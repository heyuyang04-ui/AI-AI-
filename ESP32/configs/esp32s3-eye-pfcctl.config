# Merge these options into the ESP32-S3-EYE openvela defconfig.
# USB Serial remains the NSH console; UART1 is the isolated STM32 link.
CONFIG_ESP32S3_UART1=y
CONFIG_ESP32S3_UART1_TXPIN=45
CONFIG_ESP32S3_UART1_RXPIN=46
CONFIG_SERIAL_TERMIOS=y
CONFIG_SYSTEM_PFCCTL=y
CONFIG_SYSTEM_PFCCTL_PROGNAME="pfcctl"
CONFIG_SYSTEM_PFCCTL_PRIORITY=100
CONFIG_SYSTEM_PFCCTL_STACKSIZE=4096
CONFIG_SYSTEM_PFCCTL_DEVICE="/dev/ttyS0"
CONFIG_SYSTEM_PFCCTL_TIMEOUT_MS=1200
